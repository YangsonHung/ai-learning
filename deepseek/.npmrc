# pnpm 项目配置 - 请使用 pnpm 而不是 npm
# 运行: pnpm install 而不是 npm install

# 安全配置
auto-install-peers=false
prefer-frozen-lockfile=true

# 性能优化
prefer-workspace-packages=true

# 如果看到这个文件，请使用 pnpm 命令：
# pnpm install
# pnpm add <package>
# pnpm remove <package>

# pnpm 存储路径 (默认位置):
# macOS: ~/Library/pnpm/store/v10
# Linux: ~/.local/share/pnpm/store/v10
# Windows: %LOCALAPPDATA%/pnpm/store/v10