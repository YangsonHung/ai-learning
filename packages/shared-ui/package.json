  },
  "dependencies": {
    "@ai-learning/shared-types": "workspace:*",
    "@ai-learning/shared-utils": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.11",
    "typescript": "~5.9.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  }
}