{
  "name": "@ai-learning/shared-ui",
  "version": "0.0.0",
  "description": "Shared UI components for AI Learning applications",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
