{
  "name": "ai-learning",
  "version": "1.0.0",
  "description": "AI Learning Monorepo - Multiple AI chat applications",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "preview": "pnpm -r --parallel preview",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "prettier": "^3.6.2",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "eslint": "^9.37.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}